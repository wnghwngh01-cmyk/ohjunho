{
  "name": "haru-app",
  "version": "0.1.0",
  "private": true,
  "description": "하루를 담다 Android 앱",
  "scripts": {
    "build:more-css": "tailwindcss -c scripts/tailwind.more-stitch.config.cjs -i assets/more-stitch-input.css -o assets/more-stitch.generated.css --minify",
    "build:today-css": "tailwindcss -c scripts/tailwind.today-stitch.config.cjs -i assets/today-stitch-input.css -o assets/today-stitch.generated.css --minify",
    "build:calendar-css": "tailwindcss -c scripts/tailwind.calendar-stitch.config.cjs -i assets/calendar-stitch-input.css -o assets/calendar-stitch.generated.css --minify",
    "build:finance-css": "tailwindcss -c scripts/tailwind.finance-stitch.config.cjs -i assets/finance-stitch-input.css -o assets/finance-stitch.generated.css --minify",
    "build:square-css": "tailwindcss -c scripts/tailwind.square-stitch.config.cjs -i assets/square-stitch-input.css -o assets/square-stitch.generated.css --minify",
    "build:workout-css": "tailwindcss -c scripts/tailwind.workout-stitch.config.cjs -i assets/workout-stitch-input.css -o assets/workout-stitch.generated.css --minify",
    "build:stitch-css": "pnpm run build:more-css && pnpm run build:today-css && pnpm run build:calendar-css && pnpm run build:finance-css && pnpm run build:square-css && pnpm run build:workout-css",
    "build:web": "pnpm run build:stitch-css && node scripts/build-web.mjs",
    "android:sync": "pnpm run build:web && cap sync android",
    "android:open": "pnpm run android:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "tailwindcss": "3.4.17"
  }
}
