{
  "name": "haru-app",
  "version": "0.1.0",
  "private": true,
  "description": "하루를 담다 Android 앱",
  "scripts": {
    "build:more-css": "tailwindcss -c scripts/tailwind.more-stitch.config.cjs -i assets/more-stitch-input.css -o assets/more-stitch.generated.css --minify",
    "build:web": "pnpm run build:more-css && node scripts/build-web.mjs",
    "android:sync": "pnpm run build:web && cap sync android",
    "android:open": "pnpm run android:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "tailwindcss": "3.4.17"
  }
}
