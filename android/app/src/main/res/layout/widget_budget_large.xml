<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="220dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/budget_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 달 남은 예산" android:textColor="#6B6D69" android:textSize="11sp" />
            <TextView android:id="@+id/budget_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="예산 미설정" android:textColor="#214838" android:textSize="21sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/budget_add" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_button" android:text="＋ 지출" android:textColor="#1B1C1A" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E3DF" />
    <LinearLayout android:id="@+id/budget_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/budget_row1_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#1B1C1A" android:textSize="11sp" android:textStyle="bold"/><TextView android:id="@+id/budget_row1_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6B6D69" android:textSize="11sp"/></LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"><ProgressBar android:id="@+id/budget_row1_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/widget_progress"/><ProgressBar android:id="@+id/budget_row1_progress_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/widget_progress_danger" android:visibility="gone"/></FrameLayout><TextView android:id="@+id/budget_row1_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:layout_marginTop="2dp" android:textColor="#8C8E8A" android:textSize="10sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/budget_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/budget_row2_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#1B1C1A" android:textSize="11sp" android:textStyle="bold"/><TextView android:id="@+id/budget_row2_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6B6D69" android:textSize="11sp"/></LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"><ProgressBar android:id="@+id/budget_row2_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/widget_progress"/><ProgressBar android:id="@+id/budget_row2_progress_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/widget_progress_danger" android:visibility="gone"/></FrameLayout><TextView android:id="@+id/budget_row2_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:layout_marginTop="2dp" android:textColor="#8C8E8A" android:textSize="10sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/budget_row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/budget_row3_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#1B1C1A" android:textSize="11sp" android:textStyle="bold"/><TextView android:id="@+id/budget_row3_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6B6D69" android:textSize="11sp"/></LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"><ProgressBar android:id="@+id/budget_row3_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/widget_progress"/><ProgressBar android:id="@+id/budget_row3_progress_danger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/widget_progress_danger" android:visibility="gone"/></FrameLayout><TextView android:id="@+id/budget_row3_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:layout_marginTop="2dp" android:textColor="#8C8E8A" android:textSize="10sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:gravity="center" android:text="설정된 분류별 예산이 없습니다." android:textColor="#8C8E8A" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
